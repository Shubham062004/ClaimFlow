# ==============================================================================
# ClaimFlow Express Backend Environment Configuration Template
# Copy this file to server/.env and update secret keys for your deployment.
# ==============================================================================

# Server Port
PORT=5000

# Node Environment (development | staging | production)
NODE_ENV=development

# MongoDB Connection Connection String
MONGO_URI=mongodb://127.0.0.1:27017/claimflow

# JWT Secret Key (min 32 characters for security)
JWT_SECRET=your_jwt_secret_key_should_be_at_least_32_characters_long

# JWT Token Expiration Duration
JWT_EXPIRES_IN=7d

# Allowed CORS Origins (comma-separated list)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# File Upload Storage Directory (relative to server root)
UPLOAD_DIR=src/uploads
